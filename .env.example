# DOMUREVA server-side integrations. Never expose these values through VITE_* variables.
# Gabley receives approved/reviewed funding assessments only.
GABLEY_API_URL=https://gabley.example.com
GABLEY_SYNC_SECRET=replace-with-at-least-32-random-characters

# Omniqora tenant-scoped property intelligence.
OMNIQORA_INTELLIGENCE_URL=https://omniqora.example.com/api/platform/intelligence
OMNIQORA_SERVICE_TOKEN=oqsvc_key.replace-with-at-least-32-char-secret

# Existing optional integrations
GABLEY_RETROFIT_BASE_URL=
GABLEY_RETROFIT_API_KEY=
CRAFTVARO_BASE_URL=
CRAFTVARO_API_KEY=
